{
    "name": "torneo-v2",
    "version": "2026.3.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test --no-watch",
        "test-ci": "ng test --no-watch --no-progress",
        "lint": "ng lint && stylelint \"src/**/*.{css,scss}\" && prettier --check .",
        "lint:fix": "ng lint --fix && stylelint \"src/**/*.{css,scss}\" --fix && prettier --write .",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui"
    },
    "private": true,
    "packageManager": "npm@11.9.0",
    "dependencies": {
        "@angular/common": "^21.2.0",
        "@angular/forms": "^21.2.0",
        "@angular/router": "^21.2.0",
        "@ngx-translate/core": "^17.0.0",
        "rxjs": "^7.4.0"
    },
    "devDependencies": {
        "@angular-eslint/builder": "^21.3.0",
        "@angular-eslint/eslint-plugin": "^21.3.0",
        "@angular-eslint/eslint-plugin-template": "^21.3.0",
        "@angular-eslint/schematics": "^21.3.0",
        "@angular-eslint/template-parser": "^21.3.0",
        "@angular/build": "^21.2.1",
        "@angular/cli": "^21.2.1",
        "@angular/compiler": "^21.2.1",
        "@angular/compiler-cli": "^21.2.0",
        "@angular/core": "^21.2.1",
        "@angular/platform-browser": "^21.2.1",
        "@axe-core/playwright": "^4.11.1",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/postcss": "^4.2.1",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "jsdom": "^28.1.0",
        "postcss": "^8.5.8",
        "prettier": "^3.8.1",
        "stylelint": "^17.4.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    }
}
